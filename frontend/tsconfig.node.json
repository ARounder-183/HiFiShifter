{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
        "target": "ES2023",
        "lib": ["ES2023"],
        "module": "ESNext",
        "types": ["node"],
        "skipLibCheck": true,

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,

        /* scripts/*.mjs（node 侧工具脚本）：仅纳入解析（allowJs、不开
           checkJs），编辑器至少能提供跳转/补全；类型质量由 eslint 块守。 */
        "allowJs": true,
        "checkJs": false,

        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true
    },
    /* tests/ 的三个门禁测试（buildGates / fileSizeBudget / lintBudget）导入
       vite.config.ts 与 node 模块，语义在本侧。此前不在任何 tsconfig 的
       include 图里，`tsc -b` 从不检查它们 —— 门禁自身的类型错误只会在
       vitest 运行时爆。 */
    "include": ["vite.config.ts", "vitest.config.ts", "scripts/**/*.mjs", "tests"]
}
