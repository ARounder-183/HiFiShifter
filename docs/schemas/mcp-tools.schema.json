            },
            "numerator": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "position_sec": {
              "format": "double",
              "type": "number"
            },
            "scale": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TempoScaleSpec"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Musical scale override at this tempo point. When omitted (and `clear_scale != Some(true)`),\nan existing scale override at the same `position_sec` is preserved."
            }
          },
          "required": [
            "position_sec",
            "bpm"
          ],
          "type": "object"
        },
        "TempoScaleSpec": {
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "notes": {
              "description": "Scale pitch classes (`0..=11`).",
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "type": [
                "array",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "TrackPatch": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "description": "Use an algorithm ID returned by `hfs_get_edit_capabilities`. Omit to keep App settings.",
              "type": [
                "string",
                "null"
              ]
            },
            "color": {
              "type": [
                "string",
                "null"
              ]
            },
            "compose_enabled": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "muted": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "solo": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "volume": {
              "format": "float",
              "type": [
                "number",
                "null"
              ]
            }
          },
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "All positions are absolute project seconds; source positions are seconds from the file start.\nTrack IDs may refer to a `client_id` created earlier in the same atomic edit.\nProvide either `expected_revision` (whole-project CAS) or `expected_scope`\n(root-track scoped CAS for concurrent human-agent co-editing).",
      "properties": {
        "expected_revision": {
          "default": null,
          "description": "Opaque project-wide version returned by `hfs_get_context` / `hfs_query`.",
          "type": [
            "string",
            "null"
          ]
        },
        "expected_scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/EditScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional fine-grained concurrency token allowing concurrent human edits on other root tracks."
        },
        "idempotency_key": {
          "description": "Retry the identical request with the same key after a lost response.",
          "type": "string"
        },
        "label": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/Operation"
          },
          "type": "array"
        }
      },
      "required": [
        "idempotency_key",
        "operations"
      ],
      "title": "EditRequest",
      "type": "object"
    },
    "hfs_editor_view": {
      "$defs": {
        "ViewTool": {
          "enum": [
            "select",
            "draw",
            "line",
            "vibrato"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "active_param": {
          "type": [
            "string",
            "null"
          ]
        },
        "focus_end_sec": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "focus_start_sec": {
          "default": null,
          "description": "Optional time-range focus (`[focus_start_sec, focus_end_sec]`) to pan/zoom the GUI viewport onto a phrase.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "reference_root_track_ids": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "seek_playhead": {
          "default": null,
          "description": "When `true` alongside `focus_start_sec`, also moves the transport playhead to `focus_start_sec`.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "selected_clip_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected_track_id": {
          "description": "Omit all fields to read the active editor view. This changes selection/view only, never audio.",
          "type": [
            "string",
            "null"
          ]
        },
        "tool_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ViewTool"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "title": "ViewRequest",
      "type": "object"
    },
    "hfs_get_edit_capabilities": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "track_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "title": "TargetRequest",
      "type": "object"
    },
    "hfs_history": {
      "$defs": {
        "HistoryAction": {
          "enum": [
            "undo",
            "redo"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/HistoryAction"
        },
        "expected_revision": {
          "type": "string"
        }
      },
      "required": [
        "expected_revision",
        "action"
      ],
      "title": "HistoryRequest",
      "type": "object"
    },
    "hfs_notebook": {
      "$defs": {
        "NotebookAction": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "read",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Atomically insert or replace a fenced `<!-- hfs-agent:start:<section_id> -->` section\ninside the project notebook without clobbering human notes outside that section.",
              "properties": {
                "expected_revision": {
                  "default": null,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "kind": {
                  "const": "upsert_agent_section",
                  "type": "string"
                },
                "markdown_body": {
                  "type": "string"
                },
                "section_id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "section_id",
                "title",
                "markdown_body"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "expected_revision": {
                  "default": null,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "kind": {
                  "const": "remove_agent_section",
                  "type": "string"
                },
                "section_id": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "section_id"
              ],
              "type": "object"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Human-in-the-loop collaboration via the project's built-in Markdown Notebook.",
      "properties": {
        "action": {
          "$ref": "#/$defs/NotebookAction"
        }
      },
      "required": [
        "action"
      ],
      "title": "NotebookRequest",
      "type": "object"
    },
    "hfs_query": {
      "$defs": {
        "QueryKind": {
          "enum": [
            "timeline",
            "tracks",
            "clips",
            "curve",
            "static",
            "param_blocks",
            "settings",
            "playback",
            "history",
            "render",
            "notebook",
            "ledger"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "clip_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "frame_count": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/QueryKind"
        },
        "limit": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "offset": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "param": {
          "type": [
            "string",
            "null"
          ]
        },
        "start_frame": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "track_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "title": "QueryRequest",
      "type": "object"
    },
    "hfs_render_preview": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Bounded offline mixdown & deterministic acoustic QA self-check for Agents.",
      "properties": {
        "apply_pitch_edit": {
          "default": null,
          "description": "Whether to apply vocal synthesis / pitch curves (`true` by default; `false` renders dry arrangement).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "end_sec": {
          "format": "double",
          "type": "number"
        },
        "output_wav_path": {
          "default": null,
          "description": "Optional absolute `.wav` path to write the rendered preview for multimodal audio listening.",
          "type": [
            "string",
            "null"
          ]
        },
        "overwrite": {
          "default": null,
          "description": "Must be `true` to replace an existing `.wav` file at `output_wav_path`.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "sample_rate": {
          "default": null,
          "description": "Output sample rate (`8000..=96000`, default `44100`).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "start_sec": {
          "format": "double",
          "type": "number"
        },
        "track_ids": {
          "default": null,
          "description": "Optional subset of tracks (root or child) to solo-isolate in an offscreen snapshot.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "start_sec",
        "end_sec"
      ],
      "title": "RenderPreviewRequest",
      "type": "object"
    },
    "hfs_save_project": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "expected_revision",
        "path"
      ],
      "title": "SaveRequest",
      "type": "object"
    },
    "hfs_settings": {
      "$defs": {
        "SettingsChange": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "read",
                  "type": "string"
                }
              },
              "required": [
                "action"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Both override fields are the complete desired project override; `null` means inherit App defaults.",
              "properties": {
                "action": {
                  "const": "set_project_stretch",
                  "type": "string"
                },
                "algorithm_override": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/StretchAlgorithm"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "expected_revision": {
                  "type": "string"
                },
                "hifigan_mel_stretch_override": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              },
              "required": [
                "action",
                "expected_revision"
              ],
              "type": "object"
            }
          ]
        },
        "StretchAlgorithm": {
          "enum": [
            "signalsmith",
            "soundtouch",
            "linear"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "change": {
          "$ref": "#/$defs/SettingsChange"
        }
      },
      "required": [
        "change"
      ],
      "title": "SettingsRequest",
      "type": "object"
    },
    "hfs_transport": {
      "$defs": {
        "TransportAction": {
          "enum": [
            "play",
            "stop",
            "seek"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/TransportAction"
        },
        "position_sec": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "action"
      ],
      "title": "TransportRequest",
      "type": "object"
    },
    "hfs_wait_ready": {
      "$defs": {
        "WaitTarget": {
          "enum": [
            "pitch_analysis",
            "clip_render",
            "gui_view"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Server-side readiness barrier replacing blind client sleep/polling loops.",
      "properties": {
        "clip_ids": {
          "default": null,
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/WaitTarget"
          },
          "type": "array"
        },
        "timeout_ms": {
          "default": null,
          "description": "Bounded wait timeout in milliseconds (`0..=30000`, default `5000`).",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "track_ids": {
          "default": null,
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "trigger_analysis": {
          "default": null,
          "description": "When `true` (default), proactively schedules pitch analysis on requested root tracks if missing.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "targets"
      ],
      "title": "WaitRequest",
      "type": "object"
    }
  },
  "version": "0.1.0"
}
