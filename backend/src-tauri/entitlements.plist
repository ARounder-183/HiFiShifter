<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime: allow JIT compilation (needed by ONNX Runtime) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory (ONNX Runtime, audio processing) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allow loading unsigned dynamic libraries (ONNX Runtime .dylib, ort) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Microphone access for vocal input/processing -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- User-selected file read/write (open/save project files) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Music/Downloads/Documents folder access -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
    <key>com.apple.security.files.music.read-write</key>
    <true/>

    <!-- Temporary directory access for audio processing cache -->
    <key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
    <array>
        <string>/tmp/</string>
        <string>/private/tmp/</string>
    </array>
</dict>
</plist>
