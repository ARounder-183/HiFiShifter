{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "HiFiShifter",
    "version": "0.1.0-beta.13",
    "identifier": "com.arounder.hifishifter",
    "build": {
        "beforeDevCommand": "node ../scripts/tauri-before-dev.mjs",
        "devUrl": "http://localhost:5173",
        "beforeBuildCommand": "npm --prefix ../frontend run build",
        "frontendDist": "../../frontend/dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "HiFiShifter",
                "width": 1400,
                "height": 900,
                "visible": true,
                "dragDropEnabled": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis", "dmg", "appimage"],
        "windows": {
            "nsis": {
                "installMode": "both"
            }
        },
        "resources": {
            "resources/models/nsf_hifigan/config.json": "models/nsf_hifigan/config.json",
            "resources/models/hnsep/hnsep.onnx": "models/hnsep/hnsep.onnx",
            "resources/models/hnsep/config.yaml": "models/hnsep/config.yaml",
            "resources/models/fcpe/fcpe.onnx": "models/fcpe/fcpe.onnx"
        },
        "macOS": {
            "frameworks": [
                "third_party/soundtouch-static/soundtouch/libSoundTouchDLL.dylib"
            ],
            "files": {
                "Resources/libSoundTouchDLL.dylib": "third_party/soundtouch-static/soundtouch/libSoundTouchDLL.dylib"
            }
        },
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
