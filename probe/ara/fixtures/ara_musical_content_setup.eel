// F-2 / F-3 夹具：一条**有音频**的轨道 + 挂上 HiFiShifter（ARA）。
//
// 【为什么用 EEL 而不是 Lua】`__startup.eel` 启动钩子跑的必须是 EEL（REAPER 没有
// `.lua` 的启动约定，见 ../README.md）。EEL 里的 REAPER API 不带 `reaper.` 前缀。
//
// 【为什么要建这个夹具】F-2 问的是"宿主到底推不推音乐内容（速度 / 拍号 / 调号）"，
// 那条探针内联在插件的 `create_musical_context` 里 —— 只有宿主真的建了 ARA 文档、
// 真的调了那个回调，日志里才会有 `[ara][probe]` 行。所以夹具必须让 REAPER 把
// HiFiShifter 当作 ARA 插件挂到一条**有音频**的轨道上（没有音频的轨道不会拿到内容）。
//
// 【为什么要写一个"真"速度映射】探针只记条数，不记数值。但"宿主没有音乐上下文"
// 这个结论必须排除"因为工程太简单所以宿主懒得建"：所以这里放两条速度 / 拍号标记
// （90 BPM 3/4、150 BPM 7/8），让工程确确实实拥有一张非平凡的速度映射。
// 若这样仍不出现 `[ara][probe]` 行，才能说"REAPER 不提供音乐上下文"。
//
// `__REPO_ROOT__` 由 run_probe_headless.ps1 替换成仓库根的绝对路径（正斜杠）。

InsertTrackAtIndex(0, 1);
tr = GetTrack(0, 0);
SetOnlyTrackSelected(tr);
InsertMedia("__REPO_ROOT__/probe/ara/fixtures/tone44100.wav", 0);
AddTempoTimeSigMarker(0, 1.0, 90, 3, 4, 0);
AddTempoTimeSigMarker(0, 2.0, 150, 7, 8, 1);
TrackFX_AddByName(tr, "HiFiShifter", 0, 1);

// 夹具自证：把"工程真的长这样"落成文件，否则"宿主没给音乐上下文"可能只是
// "夹具根本没搭起来"。这份读数与插件日志一起构成 F-2 的证据。
vf = fopen("__REPO_ROOT__/.build-tmp/f2-fixture.log", "w");
fprintf(vf, "tracks=%.0f\n", CountTracks(0));
fprintf(vf, "media_items=%.0f\n", CountMediaItems(0));
fprintf(vf, "tempo_markers=%.0f\n", CountTempoTimeSigMarkers(0));
fprintf(vf, "track_fx=%.0f\n", TrackFX_GetCount(tr));
fclose(vf);
